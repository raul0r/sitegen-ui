FROM node:20-bookworm-slim

WORKDIR /app

RUN groupadd --gid 1001 app && useradd --uid 1001 --gid app --create-home app \
  && chown -R app:app /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN chown -R app:app /app

USER app
EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
